APP_NAME="Devalok CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Devalok CMS ────────────────────────────────────────────────────────────
# Production values (Hostinger). Keep APP_DEBUG=false and APP_ENV=production.
# APP_URL=https://api.devaloksculptures.in
# Frontend origins allowed to call the API with credentials (comma-separated, no wildcards):
FRONTEND_URLS=http://localhost:3210
# Hosts (with port, no scheme) whose browser requests get session auth (Sanctum SPA):
SANCTUM_STATEFUL_DOMAINS=localhost:3210
# Production: share the session cookie between the site and the API subdomain.
# SESSION_DOMAIN=.devaloksculptures.in
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Next.js cache refresh after admin saves (same random value as REVALIDATE_SECRET on the frontend)
# FRONTEND_REVALIDATE_URL=https://devaloksculptures.in/api/revalidate
FRONTEND_REVALIDATE_URL=http://localhost:3210/api/revalidate
FRONTEND_REVALIDATE_SECRET=
